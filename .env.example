# Copy this file to .env, replace every placeholder, never commit .env.

# Secret key used for signing JWT access tokens (must be a strong random string in production)
SECRET_KEY=change-me-long-random-secret-key-min-32-chars

# Database connection URL (PostgreSQL in Docker, sqlite:///./dev.db for local development)
DATABASE_URL=postgresql+psycopg://datadynamo_user:change-me-postgres-password@db:5432/datadynamo_db

# Comma-separated list of allowed CORS origins for browser frontend requests
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email address for the initial admin account seeded at database startup
ADMIN_EMAIL=admin@datadynamo.com

# Password for the initial admin account seeded at database startup
ADMIN_PASSWORD=change-me-admin-password

# Filesystem path to trained ML model and preprocessor artifacts directory (/app/artifacts in Docker)
ARTIFACTS_DIR=/app/artifacts

# PostgreSQL container database username used by Docker Compose
POSTGRES_USER=datadynamo_user

# PostgreSQL container database password used by Docker Compose
POSTGRES_PASSWORD=change-me-postgres-password

# PostgreSQL container database name used by Docker Compose
POSTGRES_DB=datadynamo_db

# Google Gemini API key (optional; without it the app uses fixed template text and fallback explanations)
GEMINI_API_KEY=

# Gemini model identifier for LLM explanation generation and chat assistance
GEMINI_MODEL=gemini-3.5-flash-lite

# Timeout in seconds for Gemini API generation requests before falling back
GEMINI_TIMEOUT=10

# Maximum /explain LLM API calls permitted per user per hour
GEMINI_MAX_CALLS_PER_USER_HOUR=10

# Maximum /chat LLM API calls permitted per user per hour
GEMINI_MAX_CHAT_PER_USER_HOUR=20

# Global maximum Gemini API calls allowed across all users per minute
GEMINI_MAX_CALLS_PER_MINUTE=4

# Global maximum Gemini API calls allowed across all users per day
GEMINI_MAX_CALLS_PER_DAY=100

# Minimum cosine similarity score for TF-IDF RAG note retrieval in /chat (below this returns NOT_SURE)
RAG_MIN_SCORE=0.12

# Sampling temperature for Gemini text generation (lower values produce more deterministic responses)
GEMINI_TEMPERATURE=0.2

# Maximum output token limit for Gemini generation responses
GEMINI_MAX_OUTPUT_TOKENS=1024

# Optional Gemini thinking level config (e.g. LOW, HIGH; left empty by default to disable thinking config)
GEMINI_THINKING_LEVEL=

# Base URL for backend API baked into the frontend build (used during docker build or local development)
VITE_API_URL=http://localhost:8000
